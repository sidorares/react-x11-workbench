{
  "name": "@react-x11/workbench",
  "version": "0.1.0",
  "description": "The component workshop for react-x11: develop, test and compare components in isolation",
  "keywords": [
    "react",
    "react-x11",
    "x11",
    "components",
    "storybook",
    "workbench",
    "dev-tool"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sidorares/react-x11-workbench.git"
  },
  "author": "Andrey Sidorov <andrey.sidorov@gmail.com>",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "dist/cli/index.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "x11-workbench": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./story": {
      "types": "./dist/story/index.d.ts",
      "default": "./dist/story/index.js"
    },
    "./discovery": {
      "types": "./dist/discovery/index.d.ts",
      "default": "./dist/discovery/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepack": "npm run build",
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "shot": "tsx scripts/shot.tsx",
    "test": "tsx --test test/*.test.ts test/*.test.tsx",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-x11": "^2.2.1"
  },
  "dependencies": {
    "@react-x11/components": "^0.2.0",
    "tinyglobby": "^0.2.15",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.2.17",
    "prettier": "^3.6.0",
    "react": "^19.2.8",
    "react-x11": "^2.2.1",
    "typescript": "^7.0.2"
  }
}
