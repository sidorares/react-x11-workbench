// The build. `src/` in, `dist/` out: ESM JavaScript, declarations, and both
// map kinds — `files` ships `src` alongside `dist` so the maps resolve and
// "go to definition" lands on the TypeScript a consumer's editor can read.
//
// `types: []` is deliberate: nothing that ships may depend on `@types/node`.
// The story contract in particular is imported by consumers' story files,
// and a stray `process` or `Buffer` in `src/` should fail here rather than
// at a consumer's `tsc`.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": []
  },
  "include": ["src"]
}
